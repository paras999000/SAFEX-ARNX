# SAFEX AR Safety Command Center Environment Configuration
# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safex_safety_db?schema=public"

# Server Port
PORT=5000

# Security Key for Unity AR App and Admin API Verification (X-SAFEX-API-KEY header)
ADMIN_API_KEY="SAFEX-AR-SAFETY-KEY-2026"

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGIN="*"
